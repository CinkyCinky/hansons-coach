# ── Backend .env (skopíruj na .env a vyplň) ───────────────────────────────────
# ŽIADNE tajomstvá necommituj. Hodnoty ber z dashboardov (viď docs/SETUP.md).
# Zdroj pravdy pre produkciu = Render → service `hansons-coach-api` → Environment.

# Google AI Studio → API keys  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase → Project → Settings → API
SUPABASE_URL=https://<tvoj-projekt>.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Fernet kľúč na šifrovanie Garmin hesiel. JEDINÉ tajomstvo bez externého zdroja —
# ak sa stratí, uložené Garmin heslá sa už NEDAJÚ dešifrovať. Zálohuj do password manažéra.
# Vygenerovať nový: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# URL frontendu (pre CORS). Prod = Vercel URL.
FRONTEND_URL=https://hansons-coach.vercel.app

# ── Voliteľné (majú rozumné defaulty, netreba nastavovať) ──────────────────────
# Prepnutie Gemini modelov bez zásahu do kódu:
# GEMINI_MODEL_FLASH=gemini-3.5-flash
# GEMINI_MODEL_PRO=gemini-3.1-pro-preview
# GEMINI_MODEL_PLAN=gemini-3.1-pro-preview   # model pre generovanie plánov (Flash = rýchlejšie)
